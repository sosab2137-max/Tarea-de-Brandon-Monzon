            <h2>9. Fusionar dos ArrayList ordenados</h2>

            <pre>
import java.util.*;

public class Ejercicio9 {

    static ArrayList&lt;Integer&gt; fusionar(
        ArrayList&lt;Integer&gt; a,
        ArrayList&lt;Integer&gt; b) {

        ArrayList&lt;Integer&gt; resultado =
            new ArrayList&lt;&gt;();

        int i = 0;
        int j = 0;


        while (
            i &lt; a.size() &amp;&amp;
            j &lt; b.size()
        ) {

            if (a.get(i) &lt;= b.get(j)) {

                resultado.add(a.get(i));
                i++;

            } else {

                resultado.add(b.get(j));
                j++;
            }
        }


        while (i &lt; a.size()) {

            resultado.add(a.get(i));
            i++;
        }


        while (j &lt; b.size()) {

            resultado.add(b.get(j));
            j++;
        }


        return resultado;
    }
}
            </pre>

            <p>
                Complejidad del algoritmo: O(n + m).
            </p>

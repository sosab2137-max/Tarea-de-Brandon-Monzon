import java.util.*;

class Empleado {

    String nombre;
    String departamento;
    double salario;

    Empleado(String nombre, String departamento, double salario) {
        this.nombre = nombre;
        this.departamento = departamento;
        this.salario = salario;
    }
}

public class Ejercicio2 {

    static ArrayList&lt;Empleado&gt; filtrar(
        ArrayList&lt;Empleado&gt; lista,
        String departamento) {

        ArrayList&lt;Empleado&gt; resultado =
            new ArrayList&lt;&gt;();

        for (Empleado e : lista) {

            if (e.departamento.equalsIgnoreCase(departamento)
                &amp;&amp; e.salario &gt; 5000) {

                resultado.add(e);
            }
        }

        return resultado;
    }
}

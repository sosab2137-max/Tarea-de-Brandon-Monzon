            <h2>8. Total facturado por cliente</h2>

            <pre>
import java.util.*;

class Factura {

    int idFactura;
    String cliente;
    double monto;

    Factura(
        int idFactura,
        String cliente,
        double monto) {

        this.idFactura = idFactura;
        this.cliente = cliente;
        this.monto = monto;
    }
}


public class Ejercicio8 {

    static HashMap&lt;String, Double&gt; resumen(
        ArrayList&lt;Factura&gt; lista) {

        HashMap&lt;String, Double&gt; resultado =
            new HashMap&lt;&gt;();


        for (Factura factura : lista) {

            resultado.put(
                factura.cliente,

                resultado.getOrDefault(
                    factura.cliente,
                    0.0
                ) + factura.monto
            );
        }

        return resultado;
    }
}

            <h2>3. Ventas mensuales</h2>

            <pre>
import java.util.*;

public class Ejercicio3 {

    static double promedio(ArrayList&lt;Double&gt; ventas) {

        double suma = 0;

        for (double venta : ventas) {
            suma += venta;
        }

        return suma / ventas.size();
    }


    static double maximo(ArrayList&lt;Double&gt; ventas) {

        double max = ventas.get(0);

        for (double venta : ventas) {

            if (venta &gt; max) {
                max = venta;
            }
        }

        return max;
    }


    static double minimo(ArrayList&lt;Double&gt; ventas) {

        double min = ventas.get(0);

        for (double venta : ventas) {

            if (venta &lt; min) {
                min = venta;
            }
        }

        return min;
    }


    static int diasSobrePromedio(
        ArrayList&lt;Double&gt; ventas) {

        double promedio = promedio(ventas);
        int contador = 0;

        for (double venta : ventas) {

            if (venta &gt; promedio) {
                contador++;
            }
        }

        return contador;
    }
}

            <h2>1. Producto - Aumento de precio</h2>

            <pre>
import java.util.*;

class Producto {

    int id;
    String nombre;
    double precio;
    int stock;

    Producto(int id, String nombre, double precio, int stock) {
        this.id = id;
        this.nombre = nombre;
        this.precio = precio;
        this.stock = stock;
    }
}

public class Ejercicio1 {

    static void aumentarPrecios(
        ArrayList&lt;Producto&gt; lista,
        double porcentaje) {

        for (Producto p : lista) {

            if (p.stock &lt; 10) {
                p.precio += p.precio * porcentaje / 100;
            }
        }
    }
}
